# رابط قاعدة بيانات PostgreSQL — مثال: postgresql://user:password@localhost:5432/mydb
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# سر توقيع جلسات NextAuth — أنشئه بـ: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# رابط التطبيق الأساسي (مطلوب في الإنتاج)
NEXTAUTH_URL="http://localhost:3000"

# مفتاح OpenAI للردود الذكية (gpt-4o-mini)
OPENAI_API_KEY="sk-..."

# توكن واجهة واتساب للأعمال (Meta Cloud API)
WHATSAPP_TOKEN=""

# توكن التحقق من Webhook — تختاره بنفسك وتضعه في لوحة Meta
WHATSAPP_VERIFY_TOKEN=""

# معرّف رقم الهاتف في Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=""

# سر تطبيق Meta للتحقق من توقيع طلبات الويب هوك الواردة
META_APP_SECRET=""

# سر حماية مسار cron (/api/cron/usage) — في Vercel يُرسل تلقائياً في ترويسة Authorization
CRON_SECRET=""

# بيانات Pusher للتحديثات الفورية في صندوق الوارد
# (اختيارية — بدونها يعمل النظام بالاستطلاع الدوري)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
