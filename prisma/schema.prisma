generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  createdAt             DateTime               @default(now())
  conversationAssignees ConversationAssignee[]
  sentMessages          Message[]
  workflows             Workflow[]
  memberships           WorkspaceMember[]
}

model Workspace {
  id                            String                 @id @default(cuid())
  name                          String
  createdAt                     DateTime               @default(now())
  planId                        String?
  restrictStaff                 Boolean                @default(false)
  trialStartedAt                DateTime?
  trialEndsAt                   DateTime?
  subdomain                     String?                @unique
  customDomain                  String?                @unique
  customDomainVerificationToken String?
  customDomainVerifiedAt        DateTime?
  agents                        Agent[]
  bookings                      Booking[]
  broadcasts                    BroadcastCampaign[]
  cannedResponses               CannedResponse[]
  contacts                      Contact[]
  conversations                 Conversation[]
  dailyReports                  DailyWorkspaceReport[]
  invoices                      Invoice[]
  leadForms                     LeadForm[]
  mediaAssets                   MediaAsset[]
  scheduledMessages             ScheduledMessage[]
  settings                      Setting[]
  templates                     Template[]
  usage                         UsageRecord[]
  workflows                     Workflow[]
  plan                          Plan?                  @relation(fields: [planId], references: [id])
  invites                       WorkspaceInvite[]
  members                       WorkspaceMember[]
}

model Plan {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  priceMonthly Int
  messageLimit Int
  maxMembers   Int         @default(2)
  maxAgents    Int         @default(1)
  sortOrder    Int         @default(0)
  tokenLimit   Int         @default(1000000)
  invoices     Invoice[]
  workspaces   Workspace[]
}

model BroadcastCampaign {
  id           String           @id @default(cuid())
  workspaceId  String
  tag          String
  body         String
  templateId   String?
  status       BroadcastStatus  @default(SENDING)
  totalCount   Int              @default(0)
  sentCount    Int              @default(0)
  failedCount  Int              @default(0)
  createdById  String?
  createdAt    DateTime         @default(now())
  scheduledAt  DateTime?
  sentAt       DateTime?
  params       String[]         @default([])
  audience     Json             @default("{}")
  linkUrl      String?
  linkUrlB     String?
  bodyB        String?
  sentCountB   Int              @default(0)
  failedCountB Int              @default(0)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clicks       BroadcastClick[]
}

model BroadcastClick {
  id         String            @id @default(cuid())
  campaignId String
  contactId  String
  clickedAt  DateTime          @default(now())
  variant    String            @default("A")
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  type        String
  title       String
  body        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId, createdAt])
}

model DailyWorkspaceReport {
  id          String    @id @default(cuid())
  workspaceId String
  reportDate  String    @db.VarChar(10)
  status      String    @default("PROCESSING")
  body        String?
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, reportDate])
  @@index([status, reportDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  planId          String?
  amount          Int
  currency        String    @default("usd")
  status          String
  stripeSessionId String?   @unique
  stripeInvoiceId String?
  createdAt       DateTime  @default(now())
  plan            Plan?     @relation(fields: [planId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model InboundWebhook {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  token       String    @unique
  workflowId  String?
  autoTag     String    @default("")
  isActive    Boolean   @default(true)
  lastHitAt   DateTime?
  createdAt   DateTime  @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model OutboundWebhook {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    @default("")
  url         String
  events      String[]  @default([])
  secret      String?
  isActive    Boolean   @default(true)
  lastFiredAt DateTime?
  lastStatus  Int?
  createdAt   DateTime  @default(now())
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  prefix      String
  scopes      String[]  @default(["read"])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model WorkspaceInvite {
  id          String     @id @default(cuid())
  token       String     @unique
  workspaceId String
  role        MemberRole @default(STAFF)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        MemberRole @default(STAFF)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Agent {
  id               String            @id @default(cuid())
  workspaceId      String
  name             String
  systemPrompt     String
  welcomeMessage   String
  responseDelaySec Int               @default(3)
  handoffKeywords  String[]
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  offHoursReply    String?
  voiceReplies     Boolean           @default(false)
  instructions     Json              @default("[]")
  skills           Json              @default("[]")
  skillPrompts     Json              @default("{}")
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions         AgentVersion[]
  conversations    Conversation[]
  knowledgeSources KnowledgeSource[]
}

model AgentVersion {
  id               String   @id @default(cuid())
  agentId          String
  name             String
  systemPrompt     String
  welcomeMessage   String
  responseDelaySec Int
  handoffKeywords  String[]
  knowledge        Json     @default("[]")
  createdById      String?
  createdAt        DateTime @default(now())
  voiceReplies     Boolean  @default(false)
  instructions     Json     @default("[]")
  skills           Json     @default("[]")
  skillPrompts     Json     @default("{}")
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model KnowledgeSource {
  id           String        @id @default(cuid())
  agentId      String
  type         KnowledgeType
  title        String
  content      String
  fileUrl      String?
  createdAt    DateTime      @default(now())
  dbEngine     String?
  dbHost       String?
  dbName       String?
  dbPassword   String?
  dbPort       Int?
  dbQuery      String?
  dbUser       String?
  lastSyncedAt DateTime?
  url          String?
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String                @id @default(cuid())
  workspaceId   String
  waPhone       String
  name          String?
  notes         String?
  tags          String[]
  createdAt     DateTime              @default(now())
  stage         ContactStage          @default(NEW)
  blocked       Boolean               @default(false)
  leadScore     Int                   @default(0)
  email         String?
  bookings      Booking[]
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stageHistory  ContactStageHistory[]
  conversations Conversation[]

  @@unique([workspaceId, waPhone])
}

model ContactStageHistory {
  id        String       @id @default(cuid())
  contactId String
  stage     ContactStage
  source    String       @default("manual")
  createdAt DateTime     @default(now())
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Conversation {
  id                String                 @id @default(cuid())
  workspaceId       String
  contactId         String
  agentId           String?
  platform          Platform               @default(WHATSAPP)
  status            ConversationStatus     @default(AI)
  isArchived        Boolean                @default(false)
  lastMessageAt     DateTime?
  createdAt         DateTime               @default(now())
  closedAt          DateTime?
  followUpAt        DateTime?
  notes             String?
  tags              String[]               @default([])
  sentiment         String?
  summarizedAt      DateTime?
  summary           String?
  csatAskedAt       DateTime?
  csatPending       Boolean                @default(false)
  csatRating        Int?
  topic             ConversationTopic?
  isCritical        Boolean                @default(false)
  criticalAt        DateTime?
  agent             Agent?                 @relation(fields: [agentId], references: [id])
  contact           Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignees         ConversationAssignee[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  @@index([workspaceId, isCritical, lastMessageAt])
}

model ConversationAssignee {
  conversationId String
  userId         String
  assignedAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model CannedResponse {
  id          String    @id @default(cuid())
  workspaceId String
  shortcut    String
  body        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
}

model ScheduledMessage {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  body           String
  sendAt         DateTime
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  attempts       Int          @default(0)
  lastError      String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String
  senderType     SenderType
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  rating         String?
  isNote         Boolean          @default(false)
  senderId       String?
  mediaId        String?
  mediaMime      String?
  mediaType      String?
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?            @relation(fields: [senderId], references: [id])
}

model UsageRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  month        String
  messagesUsed Int       @default(0)
  messageLimit Int       @default(1000)
  tokensUsed   Int       @default(0)
  tokenLimit   Int       @default(1000000)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

model Setting {
  workspaceId String
  key         String
  value       String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

model PlatformSetting {
  key   String @id
  value String
}

model Workflow {
  id            String          @id @default(cuid())
  workspaceId   String
  name          String
  trigger       WorkflowTrigger
  triggerConfig Json            @default("{}")
  steps         Json            @default("[]")
  isActive      Boolean         @default(true)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  hookToken     String?         @unique
  createdBy     User?           @relation(fields: [createdById], references: [id])
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs          WorkflowRun[]
}

model WorkflowRun {
  id             String    @id @default(cuid())
  workflowId     String
  conversationId String?
  status         String
  pendingSteps   Json?
  resumeAt       DateTime?
  logs           String    @default("")
  createdAt      DateTime  @default(now())
  workflow       Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String
  title       String
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  remindedAt  DateTime?
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  filename    String
  mime        String
  dataBase64  String
  createdAt   DateTime  @default(now())
  folder      String    @default("")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LeadForm {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  title       String    @default("تواصل معنا")
  description String?
  fields      Json      @default("[]")
  autoTag     String    @default("")
  autoStage   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  language    String    @default("ar")
  body        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum MemberRole {
  OWNER
  STAFF
}

enum KnowledgeType {
  TEXT
  FILE
  DB
  WEBSITE
}

enum Platform {
  WHATSAPP
  WIDGET
  TELEGRAM
  MESSENGER
  INSTAGRAM
}

enum ConversationStatus {
  AI
  MANUAL
  HANDED_OFF
}

enum ConversationTopic {
  INQUIRY
  COMPLAINT
  BOOKING
  QUOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  AI
  HUMAN
  CUSTOMER
}

enum ContactStage {
  NEW
  CONTACTING
  INTERESTED
  NEGOTIATING
  CUSTOMER
  LOST
}

enum BroadcastStatus {
  SENDING
  SENT
  PARTIAL
  FAILED
  QUEUED
}

enum WorkflowTrigger {
  KEYWORD
  FROM_NUMBERS
  NEW_CONTACT
  STAGE_CHANGE
  NO_REPLY
  SHORTCUT
  CONVERSATION_OPENED
  CONVERSATION_CLOSED
  CONVERSATION_STARTED
  CONVERSATION_ENDED
  CONTACT_FIELD_UPDATED
  CONTACT_TAG_UPDATED
  WEBHOOK
  INCOMING_WEBHOOK
  CLICK_TO_CHAT_AD
  MANUAL
}
