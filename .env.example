# رابط قاعدة بيانات PostgreSQL — مثال: postgresql://user:password@localhost:5432/mydb
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# سر توقيع جلسات NextAuth — أنشئه بـ: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# رابط التطبيق الأساسي (مطلوب في الإنتاج)
NEXTAUTH_URL="http://localhost:3000"

# مفتاح OpenAI للردود الذكية (gpt-4o-mini)
OPENAI_API_KEY="sk-..."

# توكن واجهة واتساب للأعمال (Meta Cloud API)
WHATSAPP_TOKEN=""

# توكن التحقق من Webhook — تختاره بنفسك وتضعه في لوحة Meta
WHATSAPP_VERIFY_TOKEN=""

# معرّف رقم الهاتف في Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=""

# سر تطبيق Meta للتحقق من توقيع طلبات الويب هوك الواردة
META_APP_SECRET=""

# سر حماية مسار cron (/api/cron/usage) — في Vercel يُرسل تلقائياً في ترويسة Authorization
CRON_SECRET=""

# بيانات Pusher للتحديثات الفورية في صندوق الوارد
# (اختيارية — بدونها يعمل النظام بالاستطلاع الدوري)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# مزوّد الذكاء الاصطناعي: openai (افتراضي) | gemini | kimi | openrouter | custom
# OPENAI_API_KEY أعلاه تُستخدم كمفتاح لأي مزوّد — ضع مفتاح المزوّد المختار فيها
AI_PROVIDER="openai"

# اختياري: تجاوز اسم النموذج الافتراضي للمزوّد — مثال: gemini-2.0-flash
AI_MODEL=""

# اختياري: رابط API مخصص (إلزامي عند AI_PROVIDER=custom) — مثال: https://api.moonshot.ai/v1
AI_BASE_URL=""

# UltraMsg — مزوّد بديل لواتساب يُستخدم تلقائياً عندما تكون حقول Meta فارغة
# معرّف النسخة وتوكنها من لوحة ultramsg.com
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# مفاتيح Web Push (VAPID) — أنشئ زوجاً بـ: npx web-push generate-vapid-keys
# المفتاح العام يُعرض للمتصفح لذا يبدأ بـ NEXT_PUBLIC_
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# اختياري: بريد التواصل المضمّن في توقيع VAPID
VAPID_SUBJECT=""
